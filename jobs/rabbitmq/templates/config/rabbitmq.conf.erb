<%
  tls_enabled = p("rabbitmq.tls.enabled") == true
  dual_mode_enabled = p("rabbitmq.tls.dual-mode") == true
  management_enabled = p('management.enabled') == true

  # AMQP and the management API are configured below from the core
  # listeners.* / management.* settings. The MQTT, STOMP, Web-MQTT and
  # Web-STOMP plugins each own their own listeners and inherit none of
  # that, so with tls.enabled set and nothing said about them, they kept
  # serving plaintext on their default ports and had no TLS port at all.
  # Measured on RabbitMQ 4.2.9 with tls.enabled true, dual-mode false:
  # 5671 amqp/ssl and 15671 https came up as intended, while 1883 mqtt,
  # 61613 stomp, 15675 web-mqtt and 15674 web-stomp were still listening
  # in the clear.
  #
  # p('plugins') is the same list bin/pre-start feeds to
  # `rabbitmq-plugins enable`, so a listener is only configured for a
  # plugin that is actually turned on.
  plugins = p('plugins', [])
  mqtt_enabled = plugins.include?('rabbitmq_mqtt')
  stomp_enabled = plugins.include?('rabbitmq_stomp')
  web_mqtt_enabled = plugins.include?('rabbitmq_web_mqtt')
  web_stomp_enabled = plugins.include?('rabbitmq_web_stomp')

  # "TLS only" has to mean every protocol, not just AMQP.
  plaintext_enabled = !tls_enabled || dual_mode_enabled

  tls_ca  = "/var/vcap/jobs/rabbitmq/tls/rabbitmq.ca"
  tls_crt = "/var/vcap/jobs/rabbitmq/tls/rabbitmq.crt"
  tls_key = "/var/vcap/jobs/rabbitmq/tls/rabbitmq.key"
-%>

<% if ! tls_enabled || (tls_enabled && dual_mode_enabled) -%>
listeners.tcp.default = <%= p('rabbitmq.port') %> # 5672
<% end -%>

<% if (tls_enabled && ! dual_mode_enabled) -%>
listeners.tcp = none # disables non-tls
<% end -%>

<% if tls_enabled -%>
# https://www.rabbitmq.com/ssl.html

# TLS Listener is on port 5671
listeners.ssl.1 = <%= p("rabbitmq.tls.port") %>
# TLS Certificates
ssl_options.cacertfile           = /var/vcap/jobs/rabbitmq/tls/rabbitmq.ca
ssl_options.certfile             = /var/vcap/jobs/rabbitmq/tls/rabbitmq.crt
ssl_options.keyfile              = /var/vcap/jobs/rabbitmq/tls/rabbitmq.key
<% if p("rabbitmq.verify_peer") == true %>
ssl_options.verify               = verify_peer
ssl_options.fail_if_no_peer_cert = true
<% end -%>
# All TLS v1.2 RFC Supported Ciphers
ssl_options.versions.1 = tlsv1.2
ssl_options.ciphers.1  = TLS_RSA_WITH_AES_256_GCM_SHA384         # AES256-GCM-SHA384
ssl_options.ciphers.2  = TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA      # ECDHE-RSA-AES256-SHA
ssl_options.ciphers.3  = TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384   # ECDHE-RSA-AES256-GCM-SHA384
ssl_options.ciphers.4  = TLS_RSA_WITH_AES_128_GCM_SHA256         # AES128-GCM-SHA256
ssl_options.ciphers.5  = TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA      # ECDHE-RSA-AES128-SHA
ssl_options.ciphers.6  = TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256   # ECDHE-RSA-AES128-GCM-SHA256
ssl_options.ciphers.7  = TLS_RSA_WITH_AES_128_CBC_SHA256         # AES128-SHA256
ssl_options.ciphers.8  = TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256   # ECDHE-RSA-AES128-SHA256
# NOTE: vvv Disable these two below for tlsv1.3 vvv
ssl_options.honor_cipher_order   = true
ssl_options.honor_ecc_order      = true
# Troubleshooting: https://www.rabbitmq.com/troubleshooting-ssl.html
<% end -%>

<% if management_enabled -%>
# https://www.rabbitmq.com/management.html
<% if ! tls_enabled || (tls_enabled && dual_mode_enabled) -%>
management.tcp.port = <%= p('management.port') %>
management.tcp.compress = true
<% end -%>

<% if tls_enabled -%>
# https://www.rabbitmq.com/ssl.html
# Management TLS Listener is on port 15671
management.ssl.port = <%= p("management.tls.port") %>
# Management TLS Certificates
management.ssl.cacertfile           = /var/vcap/jobs/rabbitmq/tls/rabbitmq.ca
management.ssl.certfile             = /var/vcap/jobs/rabbitmq/tls/rabbitmq.crt
management.ssl.keyfile              = /var/vcap/jobs/rabbitmq/tls/rabbitmq.key
# All TLS v1.2 RFC Supported Ciphers
management.ssl.versions.1 = tlsv1.2
# management.ssl.versions.2 = tlsv1.3
management.ssl.ciphers.1  = TLS_RSA_WITH_AES_256_GCM_SHA384         # AES256-GCM-SHA384
management.ssl.ciphers.2  = TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA      # ECDHE-RSA-AES256-SHA
management.ssl.ciphers.3  = TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384   # ECDHE-RSA-AES256-GCM-SHA384
management.ssl.ciphers.4  = TLS_RSA_WITH_AES_128_GCM_SHA256         # AES128-GCM-SHA256
management.ssl.ciphers.5  = TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA      # ECDHE-RSA-AES128-SHA
management.ssl.ciphers.6  = TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256   # ECDHE-RSA-AES128-GCM-SHA256
management.ssl.ciphers.7  = TLS_RSA_WITH_AES_128_CBC_SHA256         # AES128-SHA256
management.ssl.ciphers.8  = TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256   # ECDHE-RSA-AES128-SHA256
<% end -%>
<% end -%>
<% if mqtt_enabled -%>
# https://www.rabbitmq.com/mqtt.html
# The MQTT plugin reuses the ssl_options above, so only the port is needed.
<% if plaintext_enabled -%>
mqtt.listeners.tcp.default = <%= p('mqtt.port') %>
<% else -%>
mqtt.listeners.tcp = none # disables non-tls
<% end -%>
<% if tls_enabled -%>
mqtt.listeners.ssl.default = <%= p('mqtt.tls.port') %>
<% end -%>
<% end -%>

<% if stomp_enabled -%>
# https://www.rabbitmq.com/stomp.html
# The STOMP plugin reuses the ssl_options above, so only the port is needed.
<% if plaintext_enabled -%>
stomp.listeners.tcp.default = <%= p('stomp.port') %>
<% else -%>
stomp.listeners.tcp = none # disables non-tls
<% end -%>
<% if tls_enabled -%>
stomp.listeners.ssl.default = <%= p('stomp.tls.port') %>
<% end -%>
<% end -%>

<% if web_mqtt_enabled -%>
# https://www.rabbitmq.com/web-mqtt.html
# Unlike mqtt and stomp, the two WebSocket plugins do NOT inherit
# ssl_options - each needs its own certificate paths.
<% if plaintext_enabled -%>
web_mqtt.tcp.port = <%= p('web_mqtt.port') %>
<% else -%>
web_mqtt.tcp.listener = none # disables non-tls
<% end -%>
<% if tls_enabled -%>
web_mqtt.ssl.port       = <%= p('web_mqtt.tls.port') %>
web_mqtt.ssl.cacertfile = <%= tls_ca %>
web_mqtt.ssl.certfile   = <%= tls_crt %>
web_mqtt.ssl.keyfile    = <%= tls_key %>
<% end -%>
<% end -%>

<% if web_stomp_enabled -%>
# https://www.rabbitmq.com/web-stomp.html
<% if plaintext_enabled -%>
web_stomp.tcp.port = <%= p('web_stomp.port') %>
<% else -%>
web_stomp.tcp.listener = none # disables non-tls
<% end -%>
<% if tls_enabled -%>
web_stomp.ssl.port       = <%= p('web_stomp.tls.port') %>
web_stomp.ssl.cacertfile = <%= tls_ca %>
web_stomp.ssl.certfile   = <%= tls_crt %>
web_stomp.ssl.keyfile    = <%= tls_key %>
<% end -%>
<% end -%>

#####Cluster configuration#####
<% if p("rabbitmq.plan") == "cluster" -%>
<%
  create_swap_delete = true
  addresses = link('rabbitmq-servers').instances.map(&:address)
  if addresses.size <= 1
    addresses = create_swap_delete ? [spec.address] : [spec.ip]
  end
-%>
<% if create_swap_delete -%>
<% cluster_formation_config = addresses.each_with_index do |fqdn, index| -%>
cluster_formation.classic_config.nodes.<%= index+1 %> = rabbit@<%= fqdn %>
<% end -%>
<% else -%>
<% cluster_formation_config = addresses.each_with_index do |ip, index| -%>
cluster_formation.classic_config.nodes.<%= index+1 %> = rabbit@<%= Digest::MD5.hexdigest(ip) %>
<% end -%>
<% end -%>
<% end -%>
